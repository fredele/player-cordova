{
    "version": "2.0.0",
    "tasks": [
      {
        "label": "Cordova Run Electron",
        "type": "shell",
        "command": "cordova",
        "args": [
          "run",
          "electron",
          "--nobuild",
          "--",
          "--remote-debugging-port=9222"
        ],
        "problemMatcher": [],
        "group": {
          "kind": "build",
          "isDefault": true
        },
        "isBackground": true,
        
      },
      

button_set_value{
 border:0;
 border-radius: 5px;
 margin-top: 20px;
}

#edit_tag, textarea {
  background-color : #4a4a4a; 
  border:0;
  color:#ffffff;
  font-style: normal;
  font-size: 110%;
  padding-left: 5px;
  border-radius:5px;
}

#edit_tag_value, textarea {
  background-color : #4a4a4a;
  border:0;
  color:#ffffff;
  font-style: normal;
  font-size: 110%;
  border-radius:5px;
  /* padding-left: 5px; */
  /* margin-left: 5px; */
}

.dropdown-item{
	
	text-transform: capitalize;
	}

.btn {
	display: inline-block;
	text-transform: capitalize;
	font-weight: 400;
	text-align: center;
	white-space: nowrap;
	vertical-align: middle;
	-webkit-user-select: none;
	-moz-user-select: none;
	-ms-user-select: none;
	user-select: none;
	border: 0px solid transparent;
	padding: .375rem .75rem;
	font-size: 1rem;
	line-height: 1.5;
	background-color :#666;
	transition:none;
	color:white;
	text-transform: capitalize;
	border: 0px;
}

.btn:hover {
    background-color:#333;
    transition: 0s;
    border: 0px solid transparent;
    color:white;
    box-shadow:none;
}



.btn:focus {
    background-color:#333;
    transition: 0s;
	border: 0px solid transparent;
    color:white;
    box-shadow:none;
}

.dropdown-menu {
	border: 0px solid transparent;
}

.tageditorlabel{
 color:#ffffff;
 font-style: normal;
 font-size: 100%;
 border: 0px;
}


#tageditormodal_error{
  margin-top:10px;
  color : #f8f8f8;
  text-align:center;
}

body {
    background-color: black;

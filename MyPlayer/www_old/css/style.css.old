/* Works on Firefox */
* {
  scrollbar-width: 10px;
  scrollbar-color: #4646463b; #3131315c;
}

/* Works on Chrome, Edge, and Safari */
*::-webkit-scrollbar {
  width: 10px;
}

*::-webkit-scrollbar-track {
  background: #4646463b;
}

*::-webkit-scrollbar-thumb {
  background-color: #3131315c;
}

a:link {
  color: #ffffff7a;
}

/* visited link */
a:visited {
  color: white;
}

/* mouse over link */
a:hover {
  color: #6e6e6e;
}

/* selected link */
a:active {
  color: white;
}

p.capitalize {
  text-transform: capitalize;
}



